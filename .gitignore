node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# Compiled assets (if using build tools)
assets/dist/
*.min.css
*.min.js
*.map

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.bak
*.backup
*.old

# Composer
vendor/
composer.lock
composer.phar

# Testing
tests/_output/*
codeception.yml

# Debug
debug.log
error_log

# Sensitive information (never commit!)
*.key
*.pem
*.cert
api-keys.txt
secrets.php
